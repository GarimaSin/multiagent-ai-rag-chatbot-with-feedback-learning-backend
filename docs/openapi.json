  "components": {
    "schemas": {
      "ChatInput": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "message": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Message"
          },
          "mode": {
            "type": "string",
            "enum": [
              "knowledge",
              "general"
            ],
            "title": "Mode",
            "default": "knowledge"
          },
          "quality": {
            "type": "string",
            "enum": [
              "fast",
              "verified"
            ],
            "title": "Quality",
            "default": "fast"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "request_id",
          "message"
        ],
        "title": "ChatInput"
      },
      "ConversationInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "default": "New conversation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConversationInput"
      },
      "DocumentInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "text": {
            "type": "string",
            "maxLength": 500000,
            "minLength": 20,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "title": "DocumentInput"
      },
      "FeedbackInput": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "rating": {
            "type": "integer",
            "enum": [
              -1,
              1
            ],
            "title": "Rating"
          },
          "correction": {
            "type": "string",
            "maxLength": 3000,
            "title": "Correction",
            "default": ""
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "evidence_chunk_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Chunk Id"
          },
          "evidence_quote": {
            "type": "string",
            "maxLength": 3000,
            "title": "Evidence Quote",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "rating"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewInput": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Action"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "note"
        ],
        "title": "ReviewInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
